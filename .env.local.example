# ================================================
# CONFIGURACIÓN RÁPIDA — copia este archivo como .env.local
# ================================================

# WhatsApp Business: código de país + número (sin el +)
# Ejemplo Perú: 51 + tu número de 9 dígitos
NEXT_PUBLIC_WHATSAPP_NUMBER=51932900134

# Upstash Redis (para contador de visitas persistente)
# Crea tu base de datos gratis en: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
